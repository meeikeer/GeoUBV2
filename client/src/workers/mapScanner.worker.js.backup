// Web Worker: escanea el PNG del mapa y genera una grilla de navegación
// Recibe el buffer de píxeles desde el hilo principal (useMapLoader)
self.onmessage = (e) => {
  const { data, width, height, tileSize } = e.data
  const TILE = tileSize || 1          // Cada tile agrupa TILE×TILE píxeles del PNG (usar 1 para pixel-perfect)
  const pixels = new Uint8ClampedArray(data)
  const cols = Math.floor(width / TILE)   // Cantidad de columnas de la grilla
  const rows = Math.floor(height / TILE)  // Cantidad de filas de la grilla

  // Grilla de costos: 0 = transitable, 999 = pared, 300/50 = obstáculo parcial
  const grid = Array.from({ length: cols }, () => Array(rows).fill(0))

  // Escanea cada tile contando cuántos píxeles oscuros contiene
  for (let tx = 0; tx < cols; tx++) {
    for (let ty = 0; ty < rows; ty++) {
      let darkCount = 0
      const baseX = tx * TILE
      const baseY = ty * TILE

      // Cuenta los píxeles oscuros dentro del tile
      for (let dx = 0; dx < TILE; dx++) {
        for (let dy = 0; dy < TILE; dy++) {
          const px = baseX + dx
          const py = baseY + dy
          if (px >= width || py >= height) continue
          const i = (py * width + px) * 4
          const r = pixels[i]
          const g = pixels[i + 1]
          const b = pixels[i + 2]
          const a = pixels[i + 3]
          // Si el píxel tiene algo de opacidad y su luminancia promedio es baja, es pared
          if (a > 0 && (r + g + b) / 3 < 180) {
            darkCount++
          }
        }
      }

      // Asigna costo según la densidad de píxeles oscuros en el tile
      const density = darkCount / (TILE * TILE)
      if (density >= 0.75) {
        grid[tx][ty] = 999      // Pared sólida: A* no atravesará este tile
      } else if (density >= 0.5) {
        grid[tx][ty] = 300      // Zona muy obstruida: evade si es posible
      } else if (density >= 0.25) {
        grid[tx][ty] = 50       // Zona semi-obstruida: costo leve
      } else {
        grid[tx][ty] = 0        // Libre: costo cero
      }
    }
  }

  // Envía la grilla resultante de vuelta al hilo principal
  self.postMessage({ grid })
}
